# ─────────────────────────────────────────────────────────────
# Plantilla de variables de entorno — Lista de la Compra IA
# Copia este archivo a `.env.local` y rellena los valores.
# NUNCA subas `.env.local` a git (ya está en .gitignore).
# ─────────────────────────────────────────────────────────────

# ── Supabase (PÚBLICAS — accesibles desde el cliente) ─────────
# URL del proyecto Supabase. En el dashboard: Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=

# Anon / Publishable Key. Segura para el cliente SOLO si RLS está activo.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Server-only (NUNCA expuestas al cliente) ─────────────────
# API Key de Google AI / Gemini. Server Actions únicamente.
GEMINI_API_KEY=

# ── Opcionales ───────────────────────────────────────────────
# Context7 API Key: aumenta los límites de consultas de documentación.
# Se puede dejar vacío si no se usa Context7 MCP.
CONTEXT7_API_KEY=

# ── Notas de seguridad ──────────────────────────────────────
# · Las variables SIN prefijo NEXT_PUBLIC_ solo se leen en servidor.
# · Si añades SUPABASE_SERVICE_ROLE_KEY, va SIN prefijo y únicamente
#   en lib/server/supabase-admin.ts.
# · Valida el entorno en runtime con Zod en src/config.py o lib/env.ts
#   para fallar rápido en build si falta alguna variable requerida.
